    <!-- Hidden for now (사용자: 기능이 애매해서 나중에 추가): the window and the relay's plugin store stay; removing Visibility here brings the button back. -->
    <Button x:Name="PluginStoreButton" Click="PluginStore_Click" Visibility="Collapsed" Style="{StaticResource LayoutButtonStyle}" Margin="0,0,8,0" ToolTip="플러그인 설치 · 제거" AutomationProperties.Name="플러그인">
     <StackPanel Orientation="Horizontal">
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA86;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock Text="플러그인" FontSize="12.5" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <Button x:Name="SkillStoreButton" Click="SkillStore_Click" Style="{StaticResource LayoutButtonStyle}" Margin="0,0,6,0" ToolTip="스킬 적용 · 해제" AutomationProperties.Name="스킬">
     <StackPanel Orientation="Horizontal">
      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE719;" FontSize="13" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock Text="스킬" FontSize="12.5" VerticalAlignment="Center"/>
