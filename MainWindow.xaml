    </Button>
    <Button x:Name="WorkSettingsButton" Click="TerminalProfiles_Click" Style="{StaticResource CaptionButton}" ToolTip="작업 설정 · 작업 폴더 · Auto Mode" AutomationProperties.Name="작업 설정"><TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE713;"/></Button>
    <Button x:Name="MinimizeWindowButton" Click="MinimizeWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="최소화" AutomationProperties.Name="최소화"><Path Data="M 0,5 L 10,5" Stroke="{StaticResource TextSecondary}" StrokeThickness="1" Width="10" Height="10"/></Button>
    <Button x:Name="MaximizeWindowButton" Click="MaximizeWindow_Click" AutomationProperties.Name="최대화 또는 복원">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="ToolTip" Value="최대화"/>
      <Setter Property="Content"><Setter.Value><Path Data="M 0,0 L 10,0 L 10,10 L 0,10 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1" Width="10" Height="10"/></Setter.Value></Setter>
      <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
       <Setter Property="ToolTip" Value="이전 크기로 복원"/>
       <Setter Property="Content"><Setter.Value><Path Data="M 3,0 L 10,0 L 10,7 M 0,3 L 7,3 L 7,10 L 0,10 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1" Width="10" Height="10"/></Setter.Value></Setter>
      </DataTrigger></Style.Triggers>
     </Style></Button.Style>
    </Button>
    <Button x:Name="CloseWindowButton" Click="CloseWindow_Click" Style="{StaticResource CaptionButton}" ToolTip="트레이로 숨기기" AutomationProperties.Name="창 닫기 · 트레이로 숨기기"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{StaticResource TextSecondary}" StrokeThickness="1" Width="10" Height="10"/></Button>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Visibility="Collapsed" Background="{StaticResource CommandSurface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
   <Grid Margin="12,5">
    <TextBlock x:Name="WorkspaceLabel" Visibility="Collapsed" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" FontSize="13"/>

   </Grid>
  </Border>
  <Grid Grid.Row="3" x:Name="WorkspaceGrid" Margin="8,8,8,0">
