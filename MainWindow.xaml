      <StackPanel><Grid Margin="2,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TerminalCountLabel" Text="터미널 0 / 8" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/><Button Grid.Column="1" Content="다음 확인" Click="NextWaiting_Click" Padding="8,4" ToolTip="질문이나 승인을 기다리는 다음 터미널로 이동"/></Grid><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="DispatcherSessions" Orientation="Vertical"/></ScrollViewer></StackPanel>
