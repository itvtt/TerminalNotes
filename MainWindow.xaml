      <StackPanel Orientation="Horizontal">
       <RadioButton x:Name="BasicWorkMode" GroupName="WorkMode" Content="일반" Tag="1" Click="WorkMode_Click" Style="{StaticResource WorkLevelButton}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="2" ToolTip="1단계 · 일반 — 처음 쓰는 분: 터미널 하나에 하고 싶은 일을 말하듯 입력" AutomationProperties.Name="일반 모드"/>
       <Border Width="10" Height="1" Background="{StaticResource Line}" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <RadioButton x:Name="PlanWorkMode" GroupName="WorkMode" Content="플랜" Tag="2" Click="WorkMode_Click" Style="{StaticResource WorkLevelButton}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="2" ToolTip="2단계 · 플랜 — 플랜(plan.md)을 세워 에이전트가 방향을 잃지 않고 계획대로 진행 · 플랜메이커는 함께 실행" AutomationProperties.Name="플랜 모드"/>
       <Border Width="10" Height="1" Background="{StaticResource Line}" VerticalAlignment="Center" IsHitTestVisible="False"/>
       <RadioButton x:Name="AdvancedWorkMode" GroupName="WorkMode" Content="고급" Tag="3" Click="WorkMode_Click" Style="{StaticResource WorkLevelButton}" WindowChrome.IsHitTestVisibleInChrome="True" Margin="2" ToolTip="3단계 · 고급 — 여러 태스크·터미널을 동시에 실행하고 Loop로 개선을 이어 가기" AutomationProperties.Name="고급 모드"/>
      </StackPanel>
     </Border>
