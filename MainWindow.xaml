     <Button x:Name="NewTerminalButton" Content="+ 터미널" Click="NewTerminal_Click" Height="30" Padding="10,3" Margin="0,0,5,0" ToolTip="OpenCode 창 열기 · 오토 모드 · Ctrl+Shift+T" AutomationProperties.Name="새 터미널"/>
    </StackPanel>
</Grid><Grid x:Name="SingleTerminalHeader" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource PanelGradient}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="SingleTerminalHeading" MouseDoubleClick="TerminalHeading_DoubleClick" ToolTip="제목을 더블클릭하면 이름을 변경합니다"><Border Padding="12,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="SingleTerminalTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SingleTerminalMeta" Grid.Row="1" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/></Grid></Border></ContentControl><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"><Button x:Name="SingleTerminalAgent" Visibility="Collapsed" Content="OpenCode ▾" Height="28" Padding="8,0" ToolTip="OpenCode 터미널 설정"/><Button x:Name="SingleTerminalStop" Visibility="Collapsed" Content="종료" Click="TerminalTerminate_Click" IsEnabled="False" Height="30" Padding="6,0" Style="{StaticResource QuietIconButton}" Margin="2,0" ToolTip="이 터미널 프로세스 종료 · 대화 기록과 계획 초안 유지" AutomationProperties.Name="이 터미널 종료"/><Button x:Name="SingleTerminalClose" Content="×" Click="TerminalClose_Click" Width="30" Height="30" Padding="0" Style="{StaticResource QuietIconButton}" Margin="2,0" ToolTip="이 터미널 닫기 · 세션 종료"/></StackPanel></Grid><TabControl x:Name="TerminalTabs" Grid.Row="2" Style="{StaticResource TerminalContentTabs}" SelectionChanged="TerminalTabs_SelectionChanged"/><UniformGrid x:Name="SplitTerminals" Grid.Row="3" Visibility="Collapsed"/></Grid>
