     <Border Background="{StaticResource SurfaceElevated}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,12"><StackPanel><TextBlock x:Name="DocumentTitle" Text="새 문서.md" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DocumentState" Text="저장되지 않은 문서" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/><WrapPanel x:Name="DocumentCommandBar" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="ToolbarSaveButton" Content="저장" Click="SaveDocument_Click" Height="32" Padding="10,4" Margin="0,0,10,0" ToolTip="현재 Markdown 저장 · Ctrl+S"/><Button x:Name="NewDocumentButton" Content="새 문서" Click="NewDocument_Click" Height="32" Padding="6,4" Margin="0,0,4,0" ToolTip="새 Markdown · Ctrl+N"/><Button x:Name="OpenDocumentButton" Content="열기" Click="OpenDocument_Click" Height="32" Padding="6,4" Margin="0,0,4,0" ToolTip="Markdown 열기 · Ctrl+O"/><Button x:Name="PreviewDocumentButton" Content="미리보기" Click="PreviewDocument_Click" Height="32" Padding="6,4" Margin="0,0,6,0" ToolTip="Markdown 편집 / 미리보기 전환"/></WrapPanel></StackPanel></Border>
     <Expander Grid.Row="1" Header="프로젝트 문서" IsExpanded="True" Margin="12,6,12,10"><Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions><TextBox x:Name="DocumentSearch" ToolTip="문서 이름과 경로 검색" TextChanged="DocumentSearch_TextChanged" AutomationProperties.Name="문서 검색"/><TreeView x:Name="DocumentList" Grid.Row="1" Margin="0,6,0,0" MouseDoubleClick="DocumentList_Open" KeyDown="DocumentList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></Grid></Expander>
     <TabControl Grid.Row="2" x:Name="DocumentTabs" Style="{StaticResource TerminalContentTabs}" SelectionChanged="DocumentTabs_SelectionChanged"><TabItem Header="편집"><TextBox x:Name="MarkdownEditor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas, Malgun Gothic" FontSize="14" BorderThickness="0" Padding="16,14" Background="#1A1A1A" Foreground="{StaticResource TextPrimary}" TextChanged="MarkdownEditor_TextChanged" SelectionChanged="MarkdownEditor_SelectionChanged" AutomationProperties.Name="Markdown 편집기"/></TabItem><TabItem Header="미리보기"><wv:WebView2 x:Name="PreviewBrowser" DefaultBackgroundColor="#1A1A1A"/></TabItem></TabControl>
     <TextBlock Grid.Row="3" x:Name="EditorPosition" Text="Ln 1, Col 1" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0"/>
    </Grid></Grid>
   </Border>
