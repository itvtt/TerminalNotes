   <Grid x:Name="TerminalHost"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition x:Name="TerminalTabsRow" Height="*"/><RowDefinition x:Name="SplitRow" Height="0"/></Grid.RowDefinitions><Grid x:Name="TerminalAreaHeader" Grid.Row="0" Background="Transparent" Margin="0,0,0,6">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button x:Name="SessionPickerButton" Grid.Column="0" MinWidth="48" MaxWidth="240" Height="30" Click="SessionPicker_Click" Padding="10,3" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" ToolTip="터미널 선택 · 전체 프로젝트와 세션 보기" AutomationProperties.Name="터미널 선택">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ActiveSessionLabel" Text="터미널 선택" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="⌄" Margin="6,0,0,0"/></Grid>
    </Button>
    <Popup x:Name="SessionPickerPopup" PlacementTarget="{Binding ElementName=SessionPickerButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
