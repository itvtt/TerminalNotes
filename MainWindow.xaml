       <Path Data="M 10,19 L 4,19 A 2,2 0 0 1 2,17 L 2,5 A 2,2 0 0 1 4,3 L 8,3 L 10,5 L 20,5 A 2,2 0 0 1 22,7 L 22,9 M 20,11 L 23,14 L 15,22 L 11,23 L 12,19 Z M 18,13 L 21,16" Width="22" Height="21" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Button>
      <Button x:Name="BasicStartTerminalButton" Grid.Column="3" Click="BasicStartTerminal_Click" Style="{StaticResource PrimaryButton}" Width="40" Height="38" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="실행 · 터미널 시작" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="설정된 작업 폴더에서 OpenCode 실행">
       <Path Data="M 2,0 L 14,8 L 2,16 Z" Width="13" Height="16" Margin="2,0,0,0" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button x:Name="BasicReconnectTerminalButton" Grid.Column="4" Click="BasicReconnectTerminal_Click" Visibility="Collapsed" IsEnabled="False" Width="40" Height="38" Padding="0" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}" ToolTip="재연결" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="현재 터미널의 기존 OpenCode 세션에 재연결">
       <Path Data="M 19,8 A 8,8 0 1 0 20,16 M 19,2 L 19,8 L 13,8" Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Button>
      <Button x:Name="BasicCloseTerminalButton" Grid.Column="5" Click="BasicCloseTerminal_Click" Width="40" Height="38" Padding="0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" ToolTip="터미널 닫기" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="현재 터미널 닫기">
       <Path Data="M 2,2 L 14,14 M 14,2 L 2,14" Width="14" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      </Button>
     </Grid>
    </Border>
    <ContentControl x:Name="BasicTerminalContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    <StackPanel x:Name="BasicEmptyState" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="20,18,20,20" MaxWidth="640">
     <Border Background="#0D0D0D" BorderBrush="#343434" BorderThickness="1" CornerRadius="8" Padding="26,24">
      <StackPanel>
       <Image x:Name="BasicBrandImage" Source="pack://siteoforigin:,,,/Assets/AppIcon.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Left" Margin="0,0,0,16"/>
       <TextBlock x:Name="BasicEmptyHeading" Text="작업 시작" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"/>
       <TextBlock x:Name="BasicEmptyHint" Text="▶ 실행 후 터미널에 작업을 입력하세요." FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="23"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Background="{StaticResource Canvas}" BorderThickness="0"><TextBlock x:Name="StatusLabel" Text="준비 중…" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0"/></Border>
 </Grid>
</Window>

