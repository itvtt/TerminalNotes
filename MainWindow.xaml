<Window x:Class="TerminalNotes.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Terminal Notes" Icon="Assets/AppIcon.ico" Width="1480" Height="920" MinWidth="820" MinHeight="480"
 Background="#121212" Foreground="#F2F2F2" FontFamily="./Assets/Fonts/#Pretendard, Segoe UI, Malgun Gothic" FontSize="14"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
 WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing" BorderBrush="#2F2F2F" BorderThickness="1">
 <WindowChrome.WindowChrome>
  <WindowChrome CaptionHeight="36" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Canvas" po:Freeze="True" Color="#121212"/><SolidColorBrush x:Key="Surface" po:Freeze="True" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="SurfaceElevated" po:Freeze="True" Color="#222222"/><SolidColorBrush x:Key="SurfaceHover" po:Freeze="True" Color="#2A2A2A"/><SolidColorBrush x:Key="Line" po:Freeze="True" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="TextPrimary" po:Freeze="True" Color="#F2F2F2"/><SolidColorBrush x:Key="TextSecondary" po:Freeze="True" Color="#BDBDBD"/>
  <SolidColorBrush x:Key="Muted" po:Freeze="True" Color="#8C8C8C"/><SolidColorBrush x:Key="Accent" po:Freeze="True" Color="#E5C07B"/><SolidColorBrush x:Key="AccentDark" po:Freeze="True" Color="#222222"/>
  <SolidColorBrush x:Key="CommandSurface" po:Freeze="True" Color="#1A1A1A"/>
  <!-- Inputs are recessed wells (darker than panels, neutral edge, gold only on focus);
       buttons are raised (lighter fill, thin champagne edge). The two never share a look. -->
  <SolidColorBrush x:Key="InputWell" po:Freeze="True" Color="#0D0D0D"/><SolidColorBrush x:Key="InputWellReadOnly" po:Freeze="True" Color="#101010"/>
  <SolidColorBrush x:Key="InputLine" po:Freeze="True" Color="#2C2C2C"/><SolidColorBrush x:Key="InputLineHover" po:Freeze="True" Color="#4A4A4A"/>
  <SolidColorBrush x:Key="InputPlaceholder" po:Freeze="True" Color="#6E6E6E"/>
  <SolidColorBrush x:Key="ButtonSurface" po:Freeze="True" Color="#242424"/><SolidColorBrush x:Key="ButtonSurfaceHover" po:Freeze="True" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="ButtonSurfacePressed" po:Freeze="True" Color="#141414"/><SolidColorBrush x:Key="ButtonLine" po:Freeze="True" Color="#3A3A3A"/>
  <SolidColorBrush x:Key="CardLine" po:Freeze="True" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="TitleBarGradient" po:Freeze="True" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="GoldHairline" po:Freeze="True" Color="#333333"/>
  <SolidColorBrush x:Key="GoldText" po:Freeze="True" Color="#F7E8C6"/><SolidColorBrush x:Key="Divider" po:Freeze="True" Color="#202020"/><SolidColorBrush x:Key="PanelEdge" po:Freeze="True" Color="#5A5A5A"/>
  <SolidColorBrush x:Key="SegmentSelected" po:Freeze="True" Color="#272727"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#D8BC82"/>
  <LinearGradientBrush x:Key="GoldFill" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6DDA2" Offset="0"/><GradientStop Color="#E3BC6E" Offset="0.55"/><GradientStop Color="#C99D50" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldFillHover" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FBE7B6" Offset="0"/><GradientStop Color="#EDC97E" Offset="0.55"/><GradientStop Color="#D4A95C" Offset="1"/></LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldFillPressed" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C99D50" Offset="0"/><GradientStop Color="#B88D44" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="GoldInk" po:Freeze="True" Color="#212121"/>
  <LinearGradientBrush x:Key="GoldLine" po:Freeze="True" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00E6C47E" Offset="0"/><GradientStop Color="#B0E6C47E" Offset="0.25"/><GradientStop Color="#FFF4DCA6" Offset="0.5"/><GradientStop Color="#B0E6C47E" Offset="0.75"/><GradientStop Color="#00E6C47E" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="ShellGradient" po:Freeze="True" Color="#161616"/>
  <SolidColorBrush x:Key="PanelGradient" po:Freeze="True" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="GoldMetal" po:Freeze="True" Color="#E5C07B"/>
  <SolidColorBrush x:Key="GoldGradient" po:Freeze="True" Color="#232323"/>
  <SolidColorBrush x:Key="GoldHoverGradient" po:Freeze="True" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="GoldPressedGradient" po:Freeze="True" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="MetalEdge" po:Freeze="True" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="SidebarGradient" po:Freeze="True" Color="#121212"/>
  <SolidColorBrush x:Key="TaskCardGradient" po:Freeze="True" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="TaskSelectedGradient" po:Freeze="True" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="BasicTaskBorder" po:Freeze="True" Color="#383838"/>
  <SolidColorBrush x:Key="ComposerGradient" po:Freeze="True" Color="#121212"/>
  <SolidColorBrush x:Key="ComposerSurface" po:Freeze="True" Color="#121212"/><SolidColorBrush x:Key="ComposerInput" po:Freeze="True" Color="#0D0D0D"/><SolidColorBrush x:Key="ComposerLine" po:Freeze="True" Color="#2C2C2C"/>
  <SolidColorBrush x:Key="TerminalHousingGradient" po:Freeze="True" Color="#101010"/>
  <SolidColorBrush x:Key="TerminalRim" po:Freeze="True" Color="#2B2B2B"/>

  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="{StaticResource SurfaceElevated}"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/>
  </Style>
  <Style TargetType="Button">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="Background" Value="{StaticResource ButtonSurface}"/>
   <Setter Property="BorderBrush" Value="{StaticResource ButtonLine}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,6"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonSurfaceHover}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{StaticResource ButtonSurfacePressed}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F4DCA6"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DocumentActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="Background" Value="{StaticResource ButtonSurface}"/><Setter Property="BorderBrush" Value="{StaticResource ButtonLine}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="ActionChrome">
     <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
     <Border x:Name="ActionOverlay" Background="{TemplateBinding Foreground}" Opacity="0" CornerRadius="6"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
     <Border x:Name="FocusOutline" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed"/>
    </Grid>
    <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionOverlay" Property="Opacity" Value="0.07"/><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionOverlay" Property="Opacity" Value="0.12"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionChrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="QuietIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <!-- Empty terminal slot: no box of its own; the dashed drop-zone inside carries the hover state. -->
  <Style x:Key="SlotButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextSecondary}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="SlotChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SlotChrome" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="SlotChrome" Property="Background" Value="#14EBC77A"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource QuietIconButton}">
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/>
   <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="CaptionChrome" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionChrome" Property="Background" Value="#2A2A2A"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionChrome" Property="Background" Value="#2A2A2A"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionChrome" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="CaptionChrome" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource GoldFill}"/><Setter Property="BorderBrush" Value="#F8E4B0"/><Setter Property="Foreground" Value="{StaticResource GoldInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="PrimaryGlow" CornerRadius="7" Margin="-2" Background="{StaticResource Accent}" Opacity="0" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="12"/></Border.Effect></Border>
     <Border x:Name="PrimaryChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Border>
     <Border x:Name="PrimaryShine" Height="1" Margin="5,1,5,0" VerticalAlignment="Top" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.22"/><DoubleAnimation Storyboard.TargetName="PrimaryShine" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/><DoubleAnimation Storyboard.TargetName="PrimaryShine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions><Setter TargetName="PrimaryChrome" Property="Background" Value="{StaticResource GoldFillHover}"/><Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#F4DCA6"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryChrome" Property="Background" Value="{StaticResource GoldFillPressed}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="PrimaryChrome" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryShine" Property="Opacity" Value="0"/><Setter TargetName="PrimaryChrome" Property="Background" Value="#1E1E1E"/><Setter TargetName="PrimaryChrome" Property="BorderBrush" Value="#2C2C2C"/><Setter Property="Foreground" Value="#6E6E6E"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Work modes are levels: a numbered stepper 1 일반 → 2 플랜 → 3 고급. -->
  <Style x:Key="WorkLevelButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Segment" Background="Transparent" CornerRadius="12" Padding="4,3,10,3">
     <StackPanel Orientation="Horizontal">
      <Border x:Name="Badge" Width="18" Height="18" CornerRadius="9" BorderThickness="1" BorderBrush="{StaticResource Muted}" Background="Transparent" VerticalAlignment="Center">
       <TextBlock x:Name="BadgeText" Text="{TemplateBinding Tag}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource SurfaceElevated}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource GoldFill}"/><Setter Property="Foreground" Value="{StaticResource GoldInk}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Badge" Property="Background" Value="{StaticResource GoldInk}"/><Setter TargetName="Badge" Property="BorderBrush" Value="{StaticResource GoldInk}"/><Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Segment" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Segment" Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TaskModeButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Segment" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource SurfaceElevated}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{StaticResource GoldFill}"/><Setter Property="Foreground" Value="{StaticResource GoldInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Segment" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Segment" Property="Opacity" Value="0.65"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ProjectArchiveTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid x:Name="TabChrome" SnapsToDevicePixels="True">
     <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
     </Border>
     <Border x:Name="TabFocus" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Border x:Name="TabUnderline" Height="2" Margin="10,0,10,0" VerticalAlignment="Bottom" CornerRadius="1" Background="{StaticResource Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceHover}"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="Transparent"/><Setter TargetName="TabUnderline" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource GoldHoverGradient}"/></MultiTrigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource ButtonSurfacePressed}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFocus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabChrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#191919"/><Setter Property="BorderBrush" Value="#585858"/><Setter Property="Foreground" Value="#FFB3B3"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#1A1A1A"/><Setter Property="BorderBrush" Value="#414141"/><Setter Property="Foreground" Value="#AAA08E"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="TaskActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="#3B3B3B"/><Setter Property="BorderBrush" Value="#00303030"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Border x:Name="TaskAction" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
     <Border x:Name="TaskActionShine" Height="1" Margin="4,1,4,0" VerticalAlignment="Top" Background="Transparent" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TaskAction" Property="Background" Value="{StaticResource ButtonSurfaceHover}"/><Setter TargetName="TaskAction" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="TaskAction" Property="Background" Value="{StaticResource ButtonSurfacePressed}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TaskAction" Property="BorderBrush" Value="#F4DCA6"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TaskAction" Property="Opacity" Value="0.45"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TaskTitleButton" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TaskRunButton" TargetType="Button" BasedOn="{StaticResource TaskActionButton}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#FAEDCF"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RunChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RunChrome" Property="Background" Value="#3B3B3B"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="RunChrome" Property="Background" Value="#252525"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RunChrome" Property="BorderBrush" Value="#F4DCA6"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="RunChrome" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BasicTaskSelectButton" TargetType="Button" BasedOn="{StaticResource TaskActionButton}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
   <Setter Property="Padding" Value="10,8"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="TaskStopButton" TargetType="Button" BasedOn="{StaticResource TaskActionButton}">
   <Setter Property="Foreground" Value="#F08A8A"/>
   <Style.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsEnabled" Value="True"/></MultiTrigger.Conditions><Setter Property="Foreground" Value="#FFA7A7"/></MultiTrigger></Style.Triggers>
  </Style>
  <Style x:Key="InputModeButton" TargetType="RadioButton">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,5"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid>
     <Border x:Name="ModeChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
     <Border x:Name="ModeUnderline" Height="2" VerticalAlignment="Bottom" Background="{StaticResource InputLine}" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ModeChrome" Property="Background" Value="#181818"/><Setter Property="Foreground" Value="{StaticResource TextPrimary}"/></Trigger>
