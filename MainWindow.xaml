     <StackPanel Margin="0,0,0,18"><TextBlock Text="태스크" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><TextBlock Text="작업 폴더" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,4"/><TextBlock x:Name="BasicWorkspaceLabel" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/></StackPanel>
