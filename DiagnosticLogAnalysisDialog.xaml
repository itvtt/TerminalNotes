<Window x:Class="TerminalNotes.DiagnosticLogAnalysisDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
 Title="문제 보내기" Width="580" Height="440" MinWidth="460" MinHeight="380"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="Assets/AppIcon.ico"
 Background="#121212" Foreground="#F2F2F2" FontFamily="./Assets/Fonts/#Pretendard, Segoe UI, Malgun Gothic" FontSize="14"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
 <Window.Resources>
        <LinearGradientBrush x:Key="GoldGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6DDA2" Offset="0"/><GradientStop Color="#E3BC6E" Offset="0.55"/><GradientStop Color="#C99D50" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldHoverGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FBE7B6" Offset="0"/><GradientStop Color="#EDC97E" Offset="0.55"/><GradientStop Color="#D4A95C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldPressedGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C99D50" Offset="0"/><GradientStop Color="#BE9349" Offset="0.55"/><GradientStop Color="#B88D44" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GoldDisabledSurface" Color="#212121" po:Freeze="True"/>

  <LinearGradientBrush x:Key="DialogSurface" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
   <GradientStop Color="#1A1A1A" Offset="0"/>
   <GradientStop Color="#1A1A1A" Offset="0.45"/>
   <GradientStop Color="#1A1A1A" Offset="1"/>
  </LinearGradientBrush>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#F2F2F2"/>
   <Setter Property="Background" Value="#1B1B1B"/>
   <Setter Property="BorderBrush" Value="#363636"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
       BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D8BC82"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#D8BC82"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
         <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#F8E4B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GoldChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </Border>
                            <Border BorderBrush="#60F2DFB6" BorderThickness="1" CornerRadius="7" Margin="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldHoverGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F2DFB6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F2DFB6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldPressedGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#D8BC82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldDisabledSurface}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#828282"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>
 <Border Background="{StaticResource DialogSurface}" BorderBrush="#363636" BorderThickness="1">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="문제 보내기" Foreground="#F2F2F2" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#B4AC9F" Margin="0,0,0,12"
             Text="어떤 문제가 있었는지 적고 ‘보내기’를 누르면 보고서와 최근 로그가 개발자에게 바로 전송됩니다. 요청문·플랜·인증 정보·파일 경로는 들어가지 않습니다."/>
  <TextBox Grid.Row="2" x:Name="ProblemDescription" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
           VerticalScrollBarVisibility="Auto" Padding="12,10" Background="#0D0D0D" Foreground="#F2F2F2"
           BorderBrush="#363636" CaretBrush="#D8BC82" MaxLength="2000"
           AutomationProperties.Name="어떤 문제가 있었는지 설명"/>
  <TextBlock Grid.Row="3" x:Name="LoadStatus" Text="보고서 준비 중…" TextWrapping="Wrap" Foreground="#868686" Margin="0,10,0,0"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
   <Button x:Name="ExportLogsButton" Content="ZIP으로 저장…" Visibility="Collapsed" Padding="14,8" Margin="0,0,8,0" Click="ExportLogs_Click"
           ToolTip="보내기가 안 될 때: 보고서와 최근 7일 로그를 ZIP 하나로 저장해 직접 보내 주세요."/>
   <Button x:Name="SendButton" Content="보내기" IsEnabled="False" Padding="18,8" Margin="0,0,8,0" Style="{StaticResource GoldButton}" Click="Send_Click"
           ToolTip="보고서와 최근 로그를 개발자에게 바로 보냅니다."/>
   <Button Content="닫기" IsCancel="True" Padding="14,8" Click="Close_Click"/>
  </StackPanel>
 </Grid>
 </Border>
</Window>
