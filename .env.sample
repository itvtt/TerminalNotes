# Terminal Notes 설정 예시
# 이 파일을 .env로 복사한 뒤 값을 채우세요. .env는 git에 올리지 않습니다.
# 값은 빌드할 때 앱에 들어갑니다. 바꾸면 앱을 다시 빌드해야 적용됩니다.
# Actions 빌드는 이 PC의 .env가 아니라 저장소 시크릿 TERMINALNOTES_ENV(.env 전체 내용)나 러너의 TERMINALNOTES_ENV_PATH 파일을 씁니다.
# 그쪽 내용도 이 파일과 같게 유지합니다(예: RELAY_PORT=2003. 시크릿에 예전 포트가 남아 있으면 Actions 빌드는 그 포트로 접속합니다).

# ── 중계 서버(API 서버)에 접속 (문제 보내기 · 스킬 · 공지) ──
# 서버 코드는 Terminal Notes 밖의 ApiServer 프로젝트(ApiServer 저장소의 server\relay.py)로 옮겼습니다. 주소·포트·키는 그대로입니다.
# 앱 설정은 이 .env 하나뿐입니다. 중계 서버(파이썬) 자체의 설정은 .env가 아니라 relay.py 맨 위 SETTINGS에서 고칩니다.
# 앱에는 RELAY_HOST·RELAY_PORT·RELAY_INGEST_KEY만 들어갑니다. 서버를 옮기면 RELAY_HOST만 바꾸고 앱을 다시 게시합니다.
# 포트를 바꿀 때는 이 RELAY_PORT와 relay.py SETTINGS의 RELAY_PORT를 함께 바꾸고, 서버 PC에서 `python relay.py --allow-firewall`로
# 그 포트를 엽니다(방화벽 규칙 이름 TerminalNotesRelay-<포트>, 지금은 TerminalNotesRelay-2003). 관리 페이지도 http://<서버 IP>:2003/ 입니다.
# 스킬·공지·문제 보고는 서버 PC의 데이터 폴더(중계 서버 2.12부터 기본 C:\ProgramData\TerminalNotesRelayData, relay.py SETTINGS의 RELAY_DATA_ROOT)에 쌓입니다.
# 이 폴더는 relay.py 폴더(TerminalNotesRelay)와 따로라 서버 폴더를 바꾸거나 지워도, 실행 계정·Python이 바뀌어도 남고, 예전 위치(%LOCALAPPDATA%\TerminalNotesRelay)의
# 데이터는 서버가 시작할 때 복사해 옵니다. 스킬·공지는 그 안 backups에 하루 한 번 ZIP으로 백업되며(python relay.py --restore-backup으로 되살림), 서버 PC를 옮길 때도 이 ZIP을 씁니다.
# relay.py를 새 버전으로 바꿔도 이 폴더의 데이터는 남습니다. 서버를 옮기면 이 폴더도 함께 옮깁니다.
# 중계 서버 PC의 IP 또는 도메인 (예: 192.168.0.10). relay.py SETTINGS의 RELAY_HOST와 같게 씁니다.
RELAY_HOST=
# 중계 서버 포트: 문제 보내기·스킬·공지가 모두 이 포트 하나를 씁니다. relay.py SETTINGS의 RELAY_PORT와 같게(기본 2003). 줄을 지우면 2003.
RELAY_PORT=2003
# (선택) 앱 키. 비우면 중계 서버가 IP만으로 받습니다. 쓰면 relay.py SETTINGS의 RELAY_INGEST_KEY와 같아야 합니다.
RELAY_INGEST_KEY=

# ── 자동 업데이트 (GitHub Actions 러너가 만든 Release를 앱이 실행할 때 확인) ──
# GitHub API 주소. GitHub Enterprise면 https://<GitHub Enterprise 주소>/api/v3, github.com이면 https://api.github.com.
# 비워 두면 Actions 러너에서 빌드할 때 그 러너의 GitHub(Enterprise면 그 주소)를 쓰고, 러너 밖에서는 github.com을 씁니다.
UPDATE_GITHUB_API=
# 릴리스를 올리는 저장소 (소유자/이름). Actions 러너에서 빌드할 때 비워 두면 그 러너의 저장소를 씁니다.
UPDATE_REPOSITORY=
# 비공개 저장소면 읽기 전용 토큰(contents: read). 공개 저장소면 비워 두세요. 앱 안에 들어가므로 읽기 권한만 주세요.
UPDATE_TOKEN=
# 릴리스에 올리는 패키지 파일 이름 (워크플로와 같아야 함)
UPDATE_ASSET=TerminalNotes-win-x64.zip

# 에이전트 선택 켜기/끄기: yes면 태스크마다(행의 에이전트 아이콘 클릭 또는 우클릭 → 에이전트) OpenCode·Codex·Claude Code를
# 고르고, no(기본)면 아이콘과 메뉴를 숨기고 모든 태스크·터미널이 OpenCode로 실행됩니다. 기본은 no, Claude Code·Codex도 쓰려면 yes.
AGENT_SELECTION=no

# 마스터 계정(쉼표로, Windows 계정 이름). 계정으로 막는 기능은 모두 이 한 줄로 정합니다:
#   Loop(1·2, 예약 실행 포함)·Auto Recommand·Loop 종료 예약, 공지 작성, 다른 사람의 스킬 수정·삭제, 스킬 보기(제목 표시줄 스킬 버튼·태스크 '스킬…').
# 스킬 보기가 열린 일반 사용자도 스킬을 쓰고 작성하며, 자기 스킬을 수정·삭제합니다. 공개·비공개는 마스터도 바꿀 수 없고 작성자만 바꿉니다.
# 줄을 지우면 기본값(test_01,test_07,test_08). 중계 서버는 relay.py SETTINGS의 MASTER_USERS에 같은 계정을 쓰면 다시 확인합니다.
# 스킬 버튼만 모두에게 열 때: MASTER_USERS=dm,*  (*는 스킬 보기에만 통하고 나머지 권한은 적힌 계정에만 남습니다. relay.py에는 *를 쓰지 않습니다)
MASTER_USERS=test_01,test_07,test_08

# OpenCode 설치 명령: OpenCode가 없을 때(또는 설정의 "OpenCode 설치" 버튼) 앱이 PowerShell 창에서 실행합니다.
# 한 줄로 쓰고, 여러 명령은 ; 로 이어 씁니다. 빌드할 때 앱에 들어갑니다. 비워 두면 설치하지 않습니다.
OPENCODE_INSTALL_COMMAND=npm install -g opencode-ai
