<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);TN_SOURCE_SERVICES_LOOPAUTORECOMMANDUSERS_CS;TN_SOURCE_TERMINALPROFILESDIALOG_XAML_CS;TN_SOURCE_GLOBALAGENTINSTRUCTIONSDIALOG_XAML_CS;TN_SOURCE_SERVICES_TERMINALLAUNCHMODES_CS;TN_SOURCE_SERVICES_TERMINALLAUNCHPROFILE_CS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>
    <Compile Include="../../Runtime.cs" Link="Runtime.cs" />
    <!-- The settings dialog reads the per-terminal agent types and the AGENT_SELECTION feature. -->
    <Compile Include="../../Services.cs" Link="Services.cs" />
    <Page Include="../../TerminalProfilesDialog.xaml" Link="TerminalProfilesDialog.xaml" />
    <Page Include="../../GlobalAgentInstructionsDialog.xaml" Link="GlobalAgentInstructionsDialog.xaml" />
    <Resource Include="../../Assets/AppIcon.ico" Link="Assets/AppIcon.ico" />
  </ItemGroup>
</Project>
