<Window x:Class="TerminalNotes.GlobalAgentInstructionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="전역 지침" Icon="Assets/AppIcon.ico"
        Width="760" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True" ResizeMode="CanResize"
        Background="#121212" Foreground="#F2F2F2" FontFamily="./Assets/Fonts/#Pretendard, Segoe UI, Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="GoldGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6DDA2" Offset="0"/><GradientStop Color="#E3BC6E" Offset="0.55"/><GradientStop Color="#C99D50" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldHoverGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FBE7B6" Offset="0"/><GradientStop Color="#EDC97E" Offset="0.55"/><GradientStop Color="#D4A95C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldPressedGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C99D50" Offset="0"/><GradientStop Color="#BE9349" Offset="0.55"/><GradientStop Color="#B88D44" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GoldDisabledSurface" Color="#212121" po:Freeze="True"/>

        <SolidColorBrush x:Key="Text" Color="#F2F2F2" po:Freeze="True"/>
        <SolidColorBrush x:Key="Muted" Color="#C9C0AE" po:Freeze="True"/>
        <SolidColorBrush x:Key="Line" Color="#3A3A3A" po:Freeze="True"/>
        <SolidColorBrush x:Key="Accent" Color="#E5C07B" po:Freeze="True"/>
        <LinearGradientBrush x:Key="HeaderSurface" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#1A1A1A" Offset="0.7"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#3A3A3A"/>
            <Setter Property="SelectionTextBrush" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6C6C6C"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E5C07B"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E5C07B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="#2A2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
            <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#F8E4B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GoldChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </Border>
                            <Border BorderBrush="#60F2DFB6" BorderThickness="1" CornerRadius="7" Margin="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldHoverGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F4DCA6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F4DCA6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldPressedGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#E5C07B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldDisabledSurface}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#828282"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</Window.Resources>
    <Border Background="#121212" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderSurface}" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CaptionTitle" Text="전역 지침" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                            ToolTip="최소화" AutomationProperties.Name="최소화" AutomationProperties.AutomationId="GlobalInstructionsMinimize">
                        <Path Data="M 0,5 L 10,5" Stroke="#C9C0AE" StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}" Click="MaximizeRestoreButton_Click"
                            ToolTip="최대화" AutomationProperties.Name="최대화" AutomationProperties.AutomationId="GlobalInstructionsMaximizeRestore">
                        <Path x:Name="MaximizeRestoreIcon" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"
                              Stroke="#C9C0AE" StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="CloseButton_Click"
                            ToolTip="닫기" AutomationProperties.Name="닫기" AutomationProperties.AutomationId="GlobalInstructionsClose">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#C9C0AE" StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    <Grid Grid.Row="1" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="전역 지침" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock Grid.Row="1" x:Name="DescriptionText" Foreground="#C9C0AE" FontSize="13"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock Grid.Row="2" x:Name="PathText" Foreground="#C9C0AE" FontSize="12"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,6,0,12"/>
        <TextBox Grid.Row="3" x:Name="InstructionsInput" AcceptsReturn="True" AcceptsTab="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Consolas, Malgun Gothic" FontSize="14" SpellCheck.IsEnabled="False"
                 AutomationProperties.Name="전역 지침 내용" AutomationProperties.AutomationId="GlobalInstructionsEditor"
                 Padding="14,12"/>
        <Border Grid.Row="4" Margin="0,12,0,0" Background="#1A1A1A" BorderBrush="#3A3A3A"
                BorderThickness="1" CornerRadius="8" Padding="12" AutomationProperties.AutomationId="GlobalInstructionsStatusBar">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SaveStatusBadge" Background="#1A1A1A" CornerRadius="6" Padding="8,4"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="SaveStatusLabel" Text="저장됨" FontSize="12" FontWeight="SemiBold"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="닫기" IsCancel="True" MinWidth="86" Margin="0,0,8,0"/>
                <Button x:Name="SaveInstructionsButton" Content="저장" IsDefault="True"
                        Click="SaveInstructionsButton_Click" MinWidth="86"
                        Style="{StaticResource GoldButton}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="56" Margin="0,8,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="SaveStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="GlobalInstructionsStatusMessage" AutomationProperties.LiveSetting="Polite"/>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
    </Grid>
    </Border>
</Window>
