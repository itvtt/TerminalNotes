<Window x:Class="TerminalNotes.TerminalProfilesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        Title="작업 설정" Icon="Assets/AppIcon.ico"
        Width="640" SizeToContent="Height" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        Background="#121212" Foreground="#F2F2F2" FontFamily="./Assets/Fonts/#Pretendard, Segoe UI, Malgun Gothic" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <LinearGradientBrush x:Key="GoldGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F6DDA2" Offset="0"/><GradientStop Color="#E3BC6E" Offset="0.55"/><GradientStop Color="#C99D50" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldHoverGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FBE7B6" Offset="0"/><GradientStop Color="#EDC97E" Offset="0.55"/><GradientStop Color="#D4A95C" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldPressedGradient" po:Freeze="True" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#C99D50" Offset="0"/><GradientStop Color="#BE9349" Offset="0.55"/><GradientStop Color="#B88D44" Offset="1"/></LinearGradientBrush>
        <SolidColorBrush x:Key="GoldDisabledSurface" Color="#212121" po:Freeze="True"/>

        <SolidColorBrush x:Key="Text" Color="#F2F2F2" po:Freeze="True"/>
        <SolidColorBrush x:Key="Muted" Color="#B9B1A2" po:Freeze="True"/>
        <SolidColorBrush x:Key="Line" Color="#4B4B4B" po:Freeze="True"/>
        <SolidColorBrush x:Key="Accent" Color="#D8BC82" po:Freeze="True"/>
        <LinearGradientBrush x:Key="DialogSurface" StartPoint="0,0" EndPoint="1,1" po:Freeze="True">
            <GradientStop Color="#1A1A1A" Offset="0"/>
            <GradientStop Color="#1A1A1A" Offset="0.42"/>
            <GradientStop Color="#1A1A1A" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="#3A3A3A"/>
            <Setter Property="SelectionTextBrush" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#6C6C6C"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#0D0D0D"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="86"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D8BC82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <!-- Dark picker for the per-terminal agent choice (gold on hover and for the chosen item). -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="#161616" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="5">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Data="M0,0 L4,4 L8,0" Stroke="#BDBDBD" StrokeThickness="1.4"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E5C07B"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#E5C07B"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="10,0,24,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="5" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter Margin="3"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Foreground" Value="#F4DCA6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#2A2A2A"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E5C07B"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WorkModeRadioCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ModeCard" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Ellipse Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="SelectionDot" Margin="5" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="ModeCard" Property="Background" Value="#242424"/>
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#F0DFBC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ModeCard" Property="BorderBrush" Value="#F0DFBC"/>
                                <Setter TargetName="ModeCard" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ModeCard" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GoldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource GoldGradient}"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#F8E4B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="GoldChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/>
                            </Border>
                            <Border BorderBrush="#30F2DFB6" BorderThickness="1" CornerRadius="3" Margin="1" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldHoverGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F2DFB6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#F2DFB6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldPressedGradient}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#D8BC82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GoldChrome" Property="Background" Value="{StaticResource GoldDisabledSurface}"/>
                                <Setter TargetName="GoldChrome" Property="BorderBrush" Value="#3A3A3A"/>
                                <Setter Property="Foreground" Value="#828282"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource DialogSurface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid>
    <Grid Margin="24,24,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
            <TextBlock x:Name="DialogHeading" Text="작업 설정" FontSize="24" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}"/>
        </Border>

        <Border Grid.Row="1" Background="#161616" BorderBrush="{StaticResource Line}" BorderThickness="1"
                CornerRadius="6" Margin="0,16,0,0" Padding="20,12">
        <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style x:Key="SettingsScrollPageButton" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="{TemplateBinding Background}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SettingsScrollThumb" TargetType="Thumb">
                <Setter Property="MinWidth" Value="8"/>
                <Setter Property="MinHeight" Value="8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbChrome" Margin="2" Background="#3A3A3A" CornerRadius="4"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbChrome" Property="Background" Value="#AAA08E"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ControlTemplate x:Key="SettingsVerticalScrollBar" TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                          Style="{StaticResource SettingsScrollPageButton}"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SettingsScrollThumb}"/>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                          Style="{StaticResource SettingsScrollPageButton}"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="PART_Track" Property="Opacity" Value="0.4"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
            <Style TargetType="ScrollBar">
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Background" Value="#121212"/>
                        <Setter Property="Width" Value="11"/>
                        <Setter Property="MinWidth" Value="11"/>
                        <Setter Property="Template" Value="{StaticResource SettingsVerticalScrollBar}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ScrollViewer.Resources>
        <StackPanel Margin="0,0,6,0">
        <!-- One column from top to bottom: setup, then tools and instructions, then per-terminal agents.
             The window height follows this content (capped to the screen, scrolling beyond that). -->
        <Grid x:Name="SettingsColumns">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <StackPanel x:Name="FirstRunWorkModeSection" Visibility="Collapsed" Margin="0,0,0,20"
                            KeyboardNavigation.DirectionalNavigation="Contained">
                    <TextBlock Text="작업 모드 선택" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}" Margin="0,0,0,12"/>
                    <RadioButton x:Name="BasicWorkModeRadio" GroupName="FirstRunWorkMode" Style="{StaticResource WorkModeRadioCard}"
                                 AutomationProperties.Name="일반 모드" AutomationProperties.HelpText="1단계 · 처음 쓰는 분: 터미널 하나에 말하듯 입력">
                        <StackPanel>
                            <TextBlock Text="1단계 · 일반 모드" FontWeight="SemiBold"/>
                            <TextBlock Text="처음 쓰는 분 · 터미널 하나에 하고 싶은 일을 말하듯 입력" Foreground="{StaticResource Muted}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PlanWorkModeRadio" GroupName="FirstRunWorkMode" Style="{StaticResource WorkModeRadioCard}"
                                 Margin="0,8,0,0" AutomationProperties.Name="플랜 모드"
                                 AutomationProperties.HelpText="2단계 · 플랜을 세워 에이전트가 계획대로 진행">
                        <StackPanel>
                            <TextBlock Text="2단계 · 플랜 모드" FontWeight="SemiBold"/>
                            <TextBlock Text="플랜을 세워 에이전트가 방향을 잃지 않고 계획대로 진행" Foreground="{StaticResource Muted}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AdvancedWorkModeRadio" GroupName="FirstRunWorkMode" Style="{StaticResource WorkModeRadioCard}"
                                 Margin="0,8,0,0" AutomationProperties.Name="고급 모드"
                                 AutomationProperties.HelpText="3단계 · 여러 터미널 동시 실행과 Loop">
                        <StackPanel>
                            <TextBlock Text="3단계 · 고급 모드" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AdvancedWorkModeDescription" Text="여러 태스크·터미널을 동시에 실행하고 Loop로 개선을 이어 가기" Foreground="{StaticResource Muted}"
                                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                <TextBlock x:Name="WorkEnvironmentHeading" Text="작업 환경" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                <StackPanel>
                    <TextBlock x:Name="WorkspaceCaption" Text="작업 폴더" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DefaultWorkspaceInput" MaxLength="4000" VerticalContentAlignment="Center"/>
                        <Button x:Name="WorkspaceBrowseButton" Grid.Column="1" Content="찾아보기…"
                                Click="WorkspaceBrowseButton_Click" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="WorkspaceFirstRunHint" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="기본은 C:\opencode입니다. 다른 폴더를 쓰려면 ‘찾아보기…’로 선택하세요."/>
                    <TextBlock x:Name="WorkspaceErrorText" Foreground="#F0A59A" TextWrapping="Wrap"
                               Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- No empty line under the folder while there is nothing to report. -->
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel x:Name="AutoModeSection" Margin="0,14,0,0">
                    <CheckBox x:Name="GlobalAutoModeToggle" Content="Auto Mode"/>
                    <TextBlock x:Name="AutoModeDescription" Text="OpenCode가 파일 수정과 명령 실행을 자동 승인합니다."
                               Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,6,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ToolsColumn" Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="도구 및 지침" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OpenCode 설치" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="OpenAutoInstallButton" Grid.Column="1" Content="OpenCode 설치"
                            Click="OpenAutoInstallButton_Click" AutomationProperties.Name="OpenCode 설치 명령 실행"
                            Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <TextBlock x:Name="AutoInstallStatusText" Foreground="{StaticResource Muted}" FontSize="13"
                           TextWrapping="Wrap" Margin="2,6,0,0" Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OpenCode 지침" FontWeight="SemiBold"/>
                        <TextBlock Text="OpenCode 자체 지침 · Terminal Notes 밖에서도 적용"
                                   Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="EditOpenCodeInstructionsButton" Grid.Column="1" Content="지침 편집"
                            Click="EditOpenCodeInstructionsButton_Click" AutomationProperties.Name="OpenCode 지침 편집"
                            ToolTip="OpenCode 지침 편집"
                            Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <!-- 전역 지침·플랜메이커 지침: master accounts only (InstructionEditors). -->
                <Grid x:Name="GlobalInstructionsRow" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="전역 지침" FontWeight="SemiBold"/>
                        <TextBlock Text="Terminal Notes의 모든 OpenCode·CMD 세션에 적용"
                                   Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="EditGlobalInstructionsButton" Grid.Column="1" Content="지침 편집"
                            Click="EditGlobalInstructionsButton_Click" AutomationProperties.Name="전역 지침 편집"
                            ToolTip="전역 지침 편집"
                            Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <Grid x:Name="PlanMakerInstructionsRow" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="플랜메이커 지침" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="EditPlanMakerInstructionsButton" Grid.Column="1" Content="지침 편집"
                            Click="EditPlanMakerInstructionsButton_Click" AutomationProperties.Name="플랜메이커 지침 편집"
                            ToolTip="플랜메이커 지침 편집"
                            Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OpenCode 설정" FontWeight="SemiBold"/>
                        <TextBlock Text="모델·권한·플러그인"
                                   Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,4,0,0"/>
                    </StackPanel>
                    <Button x:Name="EditOpenCodeConfigButton" Grid.Column="1" Content="설정 편집"
                            Click="EditOpenCodeConfigButton_Click" AutomationProperties.Name="OpenCode 설정 편집"
                            ToolTip="OpenCode 설정 편집"
                            Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
                <!-- Problems are reported automatically (AutomaticProblemReporter); the manual button is hidden. -->
                <Grid x:Name="ProblemReportRow" Margin="0,18,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="문제가 생겼을 때" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button x:Name="AnalyzeLogsButton" Grid.Column="1" Content="문제 보내기…" Click="AnalyzeLogsButton_Click"
                            AutomationProperties.Name="문제 보내기" Width="176" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Border x:Name="TerminalAgentSection" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
        <StackPanel>
            <TextBlock Text="터미널별 에이전트" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>
            <!-- Filled in code: terminal 1-8, each OpenCode / Claude Code / Codex. -->
            <UniformGrid x:Name="TerminalAgentGrid" Columns="4"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="2,6,0,0"
                       Text="새로 여는 터미널은 번호에 맞는 에이전트로 실행됩니다. Claude Code·Codex는 실행 시 플랜을 터미널에 입력하며, Loop·플랜메이커는 OpenCode를 사용합니다."/>
        </StackPanel>
        </Border>
        </StackPanel>
        </ScrollViewer>
        </Border>

        <StackPanel x:Name="SettingsFooter" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="취소" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="저장" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource GoldButton}"/>
        </StackPanel>
    </Grid>
    <!-- A faint credit on the bottom edge; it never moves the buttons. -->
    <TextBlock x:Name="CreditText" Text="made by jy01.ahn" FontSize="10" Foreground="{StaticResource Muted}" Opacity="0.55"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,4" IsHitTestVisible="False"/>
    </Grid>
    </Border>
</Window>
